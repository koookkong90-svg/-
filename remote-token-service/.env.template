"""
.env 配置文件模板

复制此文件为 .env.local 或直接设置环境变量

本地开发示例：
- cp .env.template .env.local
- source .env.local  # 或在 docker-compose 中使用 env_file: .env.local
"""

# 【必填】API 密钥 - 与主平台配置保持一致
# 生成: python -c "import secrets; print(secrets.token_hex(16))"
API_KEY=your-32-char-secret-key-here-replace-me

# 【可选】日志级别 - DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 【可选】闲鱼 API 请求超时（秒）
REQUEST_TIMEOUT=30

# 【可选】监听地址 - Docker 内通常为 0.0.0.0
LISTEN_HOST=0.0.0.0

# 【可选】监听端口
LISTEN_PORT=8000
