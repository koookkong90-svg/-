# Local disaster-recovery configuration (first version)
# Copy this file to backup.env and keep backup.env private.

# Backup bundles are stored outside the Git repository.
LOCAL_BACKUP_DIR=/var/backups/xianyu-auto-reply

# Only complete, strictly validated bundles older than this many days are removed.
LOCAL_RETENTION_DAYS=7

# Keep the project name stable so Compose finds the existing containers and volumes.
COMPOSE_PROJECT_NAME=xianyu-auto-reply

# First-version safety boundary: these paths must remain the root Compose file and .env.
COMPOSE_FILE=./docker-compose.yml
COMPOSE_ENV_FILE=./.env

# true briefly stops backend-web, websocket, and scheduler while the snapshot is made.
# false keeps them online, but static/browser archives may then be only best-effort consistent.
BACKUP_QUIESCE_SERVICES=true
